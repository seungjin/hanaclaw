# Dockerfile.skill-exec
FROM alpine:latest

ARG PYTHON_VERSION=3.14

RUN apk add --no-cache uv gcompat git curl wget bash fish wasmtime ripgrep go

ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python
ENV UV_TOOL_BIN_DIR=/opt/uv/bin
ENV PATH="/root/.local/bin:/opt/uv/bin:/opt/uv/python/bin:${PATH}"

ENV UV_SYSTEM_PYTHON=1
ENV UV_NO_PROJECT=1
ENV UV_PYTHON_PREFERENCE=managed

RUN uv python install ${PYTHON_VERSION}

RUN PYTHON_BIN=$(uv python find ${PYTHON_VERSION}) && \
    ln -sf "$PYTHON_BIN" /usr/bin/python3 && \
    ln -sf "$PYTHON_BIN" /usr/bin/python

RUN chmod -R 755 /opt/uv

RUN mkdir -p /workspace
WORKDIR /workspace
