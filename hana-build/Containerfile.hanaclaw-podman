# syntax=docker/dockerfile:1.7-labs
#
# Podman-oriented Hanaclaw image, Fedora minimal throughout.
#
# Builds the same image as `Containerfile.hanaclaw` (upstream: Alpine +
# zigbuild + musl) from Fedora packages instead: Fedora `cargo`/`rust`
# (>= 1.99, matches workspace rust-version 1.96) and `nodejs24` (matches
# `.nvmrc`). No zigbuild, no extra target, no static-link shims. Binaries link
# against the Fedora 45 runtime, so build and runtime stay on one Fedora
# release.
#
# Stage structure mirrors `Containerfile.hanaclaw`:
#   web-builder   OpenAPI spec -> TS client -> Vite bundle
#   builder       stubbed dependency pre-fetch, then the real build
#   runtime       lean server image (no Podman)
#   podman-image  runtime + nested/rootless Podman (last stage = default)
#
# Build from the repository root:
#   podman build -f hana-build/Containerfile.hanaclaw-podman \
#     --build-arg ZEROCLAW_BUILD_ID=$(git describe --always --dirty) \
#     -t ghcr.io/seungjin/hanaclaw-podman:latest .
# Lean server image only (no Podman):
#   ... --target runtime -t ghcr.io/seungjin/hanaclaw:latest .

# >>> generated:container-standard by `cargo generate installers` - do not edit <<<
ARG ZEROCLAW_CARGO_FLAGS="--no-default-features --features acp-bridge,agent-runtime,channel-acp-server,channel-discord,channel-email,channel-filesystem,channel-git,channel-lark,channel-matrix,channel-telegram,channel-webhook,gateway,observability-prometheus,plugins-wasm-cranelift,schema-export,tool-claude-code,tool-claude-code-runner,tool-codex-cli,tool-composio,tool-gemini-cli,tool-google-workspace,tool-jira,tool-linkedin,tool-microsoft365,tool-notion,tool-opencode-cli,tool-project-intel,tools-external,whatsapp-web"
# >>> end generated:container-standard <<<

# The ARG above is global. The builder re-declares it before expanding it;
# without that re-declaration the stage sees an empty value and cargo builds
# with its default features, which have no `plugin` subcommand.

# ── Stage: web-builder (OpenAPI spec -> TS client -> Vite bundle) ──
FROM registry.fedoraproject.org/fedora-minimal:latest AS web-builder

# gcc-c++ is required by inkjet (zerocode's syntax highlighter) for its
# tree-sitter grammars. perl-IPC-Cmd/perl-FindBin are configure dependencies of
# native crates reached from the spec-dump build.
RUN microdnf install -y --setopt=install_weak_deps=0 \
        cargo gcc gcc-c++ make nodejs24 npm pkgconf-pkg-config \
        perl-FindBin perl-IPC-Cmd \
    && microdnf clean all

WORKDIR /src

# Manifests and the npm lockfile before any source, so the dependency layer
# survives source edits while manifests stay unchanged.
COPY Cargo.toml Cargo.lock ./
COPY vendor/ vendor/
COPY wit/ wit/
COPY --parents crates/*/Cargo.toml ./
COPY --parents crates/*/tests/fixtures/*/Cargo.toml ./
COPY --parents tests/fixtures/*/Cargo.toml ./
COPY --parents crates/zeroclaw-macros/src/ ./
COPY apps/tauri/Cargo.toml apps/tauri/Cargo.toml
COPY apps/zerocode/Cargo.toml apps/zerocode/Cargo.toml
COPY apps/zerorelay/Cargo.toml apps/zerorelay/Cargo.toml
COPY tools/fill-translations/Cargo.toml tools/fill-translations/Cargo.toml
COPY xtask/Cargo.toml xtask/Cargo.toml
COPY web/package.json web/package-lock.json web/

# Same stub set as the builder: `spec-dump` builds `xtask` inside the
# workspace, which needs every member target to exist.
RUN mkdir -p src src/bin benches apps/tauri/src apps/zerocode/src apps/zerorelay/src tools/fill-translations/src xtask/src/bin \
    && echo "fn main() {}" > src/main.rs \
    && echo "" > src/lib.rs \
    && echo "fn main() {}" > src/bin/zeroclaw-acp-bridge.rs \
    && echo "fn main() {}" > benches/agent_benchmarks.rs \
    && echo "fn main() {}" > apps/tauri/src/main.rs \
    && echo "fn main() {}" > apps/tauri/build.rs \
    && echo "fn main() {}" > apps/zerocode/src/main.rs \
    && echo "fn main() {}" > apps/zerocode/build.rs \
    && echo "fn main() {}" > apps/zerorelay/src/main.rs \
    && echo "" > apps/zerorelay/src/lib.rs \
    && echo "fn main() {}" > tools/fill-translations/src/main.rs \
    && echo "" > xtask/src/lib.rs \
    && echo "fn main() {}" > xtask/src/bin/mdbook.rs \
    && echo "fn main() {}" > xtask/src/bin/fluent.rs \
    && echo "fn main() {}" > xtask/src/bin/web.rs \
    && mkdir -p crates/zeroclaw-hardware/examples crates/zeroclaw-plugins/examples \
    && echo "fn main() {}" > crates/zeroclaw-hardware/examples/esp32_sim.rs \
    && echo "fn main() {}" > crates/zeroclaw-plugins/examples/sign_manifest.rs \
    && for d in crates/*/; do \
        [ "$d" = "crates/zeroclaw-macros/" ] && continue; \
        mkdir -p "${d}src"; \
        printf '' > "${d}src/lib.rs"; \
    done \
    && for d in crates/*/tests/fixtures/*/; do \
        [ -f "${d}Cargo.toml" ] || continue; \
        mkdir -p "${d}src"; \
        printf '' > "${d}src/lib.rs"; \
    done \
    && for d in tests/fixtures/*/; do \
        [ -f "${d}Cargo.toml" ] || continue; \
        mkdir -p "${d}src"; \
        printf '' > "${d}src/lib.rs"; \
    done \
    && echo "fn main() {}" > crates/zeroclaw-log/tests/fixtures/attribution-macro-consumer/src/main.rs

RUN --mount=type=cache,id=hanaclaw-cargo-registry,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,id=hanaclaw-cargo-git,target=/root/.cargo/git,sharing=locked \
    --mount=type=cache,id=hanaclaw-web-target,target=/src/target,sharing=locked \
    cargo fetch --locked

RUN cd web && npm ci --ignore-scripts

RUN rm -rf src/ apps/zerocode/src/ apps/zerorelay/src/ tools/fill-translations/src/ \
           xtask/src/ crates/*/src/

# Only what `spec-dump` traverses: the real crates tree, xtask, and the stubbed
# root crate (its lib is needed, main is a stub). `xtask` links `zerocode`,
# so copy its real sources; the `zerocode` member is the TUI binary, whose
# sources `spec-dump` never needs.
COPY src/main.rs src/main.rs
COPY crates/ crates/
COPY xtask/ xtask/
COPY apps/zerocode/src/ apps/zerocode/src/

# `spec-dump` is the hermetic half of `cargo web gen-api`: it writes
# openapi.json + api-descriptions.ts + api-enums.ts from Rust, without npm.
# npm then derives api-generated.ts from the vendored openapi-typescript;
# `npm run build` is `check:generated && tsc -b && vite build`.
RUN --mount=type=cache,id=hanaclaw-cargo-registry,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,id=hanaclaw-cargo-git,target=/root/.cargo/git,sharing=locked \
    --mount=type=cache,id=hanaclaw-web-target,target=/src/target,sharing=locked \
    cargo run --release --offline --frozen -p xtask --bin web -- spec-dump --out /tmp/spec-dump

COPY web/ web/
RUN cp /tmp/spec-dump/api-descriptions.ts /tmp/spec-dump/api-enums.ts web/src/lib/ \
    && cd web \
    && npx --no-install openapi-typescript /tmp/spec-dump/openapi.json -o src/lib/api-generated.ts \
    && npm run build

# ── Stage: builder (zeroclaw + zerocode, Fedora-native binaries) ──
FROM registry.fedoraproject.org/fedora-minimal:latest AS builder

# Re-declare the global feature ARG so this stage can expand it, then pin it as
# the stage's ENV so both the prefetch and the real build see one value.
ARG ZEROCLAW_CARGO_FLAGS
ENV ZEROCLAW_CARGO_FLAGS=${ZEROCLAW_CARGO_FLAGS}

RUN microdnf install -y --setopt=install_weak_deps=0 \
        cargo gcc gcc-c++ make cmake \
        pkgconf-pkg-config openssl-devel zlib-ng-compat-devel sqlite-devel \
        perl perl-FindBin perl-IPC-Cmd \
    && microdnf clean all

WORKDIR /src

# No `.git` in the build context (`.dockerignore`); the commit is passed in.
ARG ZEROCLAW_BUILD_ID=""
ENV ZEROCLAW_BUILD_ID=${ZEROCLAW_BUILD_ID}

# 1. Manifests, then stub every workspace member and pre-fetch dependencies.
#    This layer is invalidated only by a lockfile/manifest/vendor/wit change;
#    normal source edits rebuild just the binaries below.
COPY Cargo.toml Cargo.lock ./
COPY vendor/ vendor/
COPY wit/ wit/
COPY --parents crates/*/Cargo.toml ./
COPY --parents crates/*/tests/fixtures/*/Cargo.toml ./
COPY --parents tests/fixtures/*/Cargo.toml ./
COPY --parents crates/zeroclaw-macros/src/ ./
COPY apps/tauri/Cargo.toml apps/tauri/Cargo.toml
COPY apps/zerocode/Cargo.toml apps/zerocode/Cargo.toml
COPY apps/zerorelay/Cargo.toml apps/zerorelay/Cargo.toml
COPY tools/fill-translations/Cargo.toml tools/fill-translations/Cargo.toml
COPY xtask/Cargo.toml xtask/Cargo.toml
RUN mkdir -p src src/bin benches apps/tauri/src apps/zerocode/src apps/zerorelay/src tools/fill-translations/src xtask/src/bin \
    && echo "fn main() {}" > src/main.rs \
    && echo "" > src/lib.rs \
    && echo "fn main() {}" > src/bin/zeroclaw-acp-bridge.rs \
    && echo "fn main() {}" > benches/agent_benchmarks.rs \
    && echo "fn main() {}" > apps/tauri/src/main.rs \
    && echo "fn main() {}" > apps/tauri/build.rs \
    && echo "fn main() {}" > apps/zerocode/src/main.rs \
    && echo "fn main() {}" > apps/zerocode/build.rs \
    && echo "fn main() {}" > apps/zerorelay/src/main.rs \
    && echo "" > apps/zerorelay/src/lib.rs \
    && echo "fn main() {}" > tools/fill-translations/src/main.rs \
    && echo "" > xtask/src/lib.rs \
    && echo "fn main() {}" > xtask/src/bin/mdbook.rs \
    && echo "fn main() {}" > xtask/src/bin/fluent.rs \
    && echo "fn main() {}" > xtask/src/bin/web.rs \
    && mkdir -p crates/zeroclaw-hardware/examples crates/zeroclaw-plugins/examples \
    && echo "fn main() {}" > crates/zeroclaw-hardware/examples/esp32_sim.rs \
    && echo "fn main() {}" > crates/zeroclaw-plugins/examples/sign_manifest.rs \
    && for d in crates/*/; do \
        [ "$d" = "crates/zeroclaw-macros/" ] && continue; \
        mkdir -p "${d}src"; \
        printf '' > "${d}src/lib.rs"; \
    done \
    && for d in crates/*/tests/fixtures/*/; do \
        [ -f "${d}Cargo.toml" ] || continue; \
        mkdir -p "${d}src"; \
        printf '' > "${d}src/lib.rs"; \
    done \
    && for d in tests/fixtures/*/; do \
        [ -f "${d}Cargo.toml" ] || continue; \
        mkdir -p "${d}src"; \
        printf '' > "${d}src/lib.rs"; \
    done \
    && echo "fn main() {}" > crates/zeroclaw-log/tests/fixtures/attribution-macro-consumer/src/main.rs

RUN --mount=type=cache,id=hanaclaw-cargo-registry,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,id=hanaclaw-cargo-git,target=/root/.cargo/git,sharing=locked \
    --mount=type=cache,id=hanaclaw-target,target=/src/target,sharing=locked \
    cargo fetch --locked

# 2. Copy only build-relevant sources, then rebuild the stubbed binaries for
#    real. apps/zerocode ships in the image and its source embeds generated
#    theme presets, so web/src/ (the theme registry) must be present too.
COPY src/ src/
COPY benches/ benches/
COPY crates/ crates/
COPY xtask/ xtask/
COPY tools/fill-translations/ tools/fill-translations/
COPY apps/zerocode/ apps/zerocode/
COPY web/src/ web/src/
COPY locales.toml .
COPY build.rs .

# Bust the stubbed root crate and zerocode so the real sources rebuild.
RUN --mount=type=cache,id=hanaclaw-cargo-registry,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,id=hanaclaw-cargo-git,target=/root/.cargo/git,sharing=locked \
    --mount=type=cache,id=hanaclaw-target,target=/src/target,sharing=locked \
    rm -rf target/release/.fingerprint/zeroclaw-* \
           target/release/deps/zeroclaw-* \
           target/release/build/zeroclaw-* \
           target/release/incremental/zeroclaw-* \
           target/release/.fingerprint/zerocode-* \
           target/release/deps/zerocode-* \
           target/release/build/zerocode-* \
           target/release/incremental/zerocode-* \
    && if [ -z "$ZEROCLAW_CARGO_FLAGS" ]; then \
         echo "ERROR: ZEROCLAW_CARGO_FLAGS is empty; the feature ARG was not passed to this stage" >&2; \
         exit 1; \
       fi \
    && cargo build --offline --frozen --release -p zeroclaw -p zerocode $ZEROCLAW_CARGO_FLAGS \
    && cp target/release/zeroclaw /src/zeroclaw \
    && cp target/release/zerocode /src/zerocode

# The Fedora build must ship the plugin host: `plugin` is gated behind the
# `plugins-wasm` feature, and a default-feature binary lacks the subcommand.
RUN zeroclaw_bin=/src/zeroclaw; \
    "$zeroclaw_bin" plugin --help >/dev/null 2>&1 || { \
      echo "ERROR: $zeroclaw_bin has no 'plugin' subcommand; ZEROCLAW_CARGO_FLAGS was not applied" >&2; \
      exit 1; \
    }

RUN for binary in zeroclaw zerocode; do \
      size=$(stat -c%s "/src/$binary"); \
      if [ "$size" -lt 1000000 ]; then \
        echo "ERROR: $binary is only ${size} bytes" >&2; \
        exit 1; \
      fi; \
    done

# ── Stage: runtime (Fedora minimal server image, no Podman) ──
FROM registry.fedoraproject.org/fedora-minimal:latest AS runtime

RUN microdnf install -y --setopt=install_weak_deps=0 \
        bash ca-certificates curl git tzdata \
    && microdnf clean all \
    && mkdir -p /zeroclaw-data/.zeroclaw /zeroclaw-data/data

# Dashboard assets live outside the documented /zeroclaw-data mount point so a
# volume or bind mount there cannot shadow them.
COPY --from=builder /src/zeroclaw /usr/local/bin/zeroclaw
COPY --from=builder /src/zerocode /usr/local/bin/zerocode
COPY --from=web-builder /src/web/dist /usr/share/zeroclawlabs/web/dist
COPY dev/config.template.toml /zeroclaw-data/.zeroclaw/config.toml

ENV LANG=C.UTF-8 \
    ZEROCLAW_DATA_DIR=/zeroclaw-data/data \
    HOME=/zeroclaw-data \
    ZEROCLAW_gateway__port=42617

WORKDIR /zeroclaw-data
EXPOSE 42617

HEALTHCHECK --interval=60s --timeout=10s --retries=3 --start-period=10s \
    CMD ["zeroclaw", "status", "--format=exit-code"]

ENTRYPOINT ["zeroclaw"]
CMD ["daemon"]

# ── Stage: podman-image (runtime + nested/rootless Podman) ──
FROM runtime AS podman-image

RUN microdnf install -y --setopt=install_weak_deps=0 \
        podman podman-docker fuse-overlayfs iptables-nft shadow-utils \
    && microdnf clean all \
    # Fedora ships the defaults as a vendor drop; Alpine patches them in place.
    # Same outcome as the Alpine image: no nested Podman service, no docker alias
    # script, cgroups inherited from the host.
    && sed -i 's/#cgroups = "enabled"/cgroups = "disabled"/' /usr/share/containers/containers.conf \
    && touch /etc/containers/nodocker

# The host rootless Podman socket is mounted in (see hanaclaw.yaml):
#   podman run -d --name hanaclaw --privileged --group-add keep-groups \
#     -p 9160:42617 \
#     -v hanaclaw-data:/zeroclaw-data \
#     -v $XDG_RUNTIME_DIR/podman/podman.sock:/run/podman/podman.sock \
#     --add-host host.docker.internal:host-gateway \
#     ghcr.io/seungjin/hanaclaw-podman:latest
ENV CONTAINER_HOST=unix:///run/podman/podman.sock \
    DOCKER_HOST=unix:///run/podman/podman.sock
